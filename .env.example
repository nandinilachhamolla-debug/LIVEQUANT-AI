# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# --- General ---
LOG_LEVEL=INFO

# --- Cryptocurrency (CoinDCX public ticker, no key required) ---
CRYPTO_POLL_SECONDS=5
# Data is labelled LIVE while the last successful poll is younger than this.
# LIVE_MAX_AGE_SECONDS=20
# After this many seconds without a successful poll, data is UNAVAILABLE.
# DATA_UNAVAILABLE_AFTER_SECONDS=300

# --- Indian stocks (NSE/BSE) ---
# One of: upstox, angelone, kite, dhan, fyers
INDIAN_STOCK_PROVIDER=
INDIAN_STOCK_API_KEY=
INDIAN_STOCK_ACCESS_TOKEN=
